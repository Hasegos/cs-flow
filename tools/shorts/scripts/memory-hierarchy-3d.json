{
  "id": "memory-hierarchy-3d",
  "path": "/arch/memory-hierarchy",
  "tab": "visualizer",
  "prep": [
    {
      "click": "3D 팝업북",
      "wait": 7000
    }
  ],
  "settle": 1500,
  "duration": 27000,
  "timeline": [
    {
      "t": 0,
      "caption": "CPU와 가까울수록\n빠르고 용량이 작습니다"
    },
    {
      "t": 3500,
      "do": [
        {
          "click": "2x"
        },
        {
          "clickSel": ".mem-hier3d__btn--icon.mem-hier3d__btn--primary"
        }
      ]
    },
    {
      "when": {
        "sel": ".mem-hier3d__badge",
        "text": "CACHE MISS"
      },
      "caption": "① 캐시 미스\nRAM에서 CPU까지 올라옵니다"
    },
    {
      "when": {
        "sel": ".mem-hier3d__badge",
        "text": "L1 HIT"
      },
      "caption": "② L1 캐시 적중\n이번엔 훨씬 빠릅니다"
    },
    {
      "when": {
        "sel": ".mem-hier3d__badge",
        "text": "CACHE LINE"
      },
      "caption": "③ 캐시 라인\n옆 칸도 함께 올라옵니다"
    },
    {
      "when": {
        "sel": ".mem-hier3d__badge",
        "text": "PAGE FAULT"
      },
      "caption": "④ 페이지 폴트\nSSD까지 내려가면 훨씬 느립니다"
    },
    {
      "when": {
        "sel": ".mem-hier3d__caption",
        "startsWith": "Result: 약 50"
      },
      "delay": 2500,
      "caption": "가까운 계층일수록 빠르고\n멀수록 느리고 큽니다",
      "cta": "직접 돌려 보기 → 프로필 링크"
    }
  ],
  "hook": "CPU가 데이터를 찾으러 가는 길\n메모리 계층 구조 3D",
  "viz": {
    "top": 150,
    "height": 440
  },
  "hide": [
    ".mem-hier3d__toolbar",
    ".mem-hier3d__controls"
  ],
  "copy": {
    "subject": "arch",
    "slug": "memory-hierarchy",
    "hookQ": "CPU는 데이터를 어디까지 찾으러 갈까?",
    "points": [
      "캐시 미스 → L1 적중 → 캐시 라인 → 페이지 폴트까지 3D로 따라가 봅니다",
      "가까운 계층일수록 빠르고 용량이 작습니다"
    ],
    "tags": [
      "컴퓨터구조",
      "메모리계층",
      "캐시"
    ]
  },
  "css": ".mem-hier3d__stage{height:436px!important;aspect-ratio:auto!important}"
}